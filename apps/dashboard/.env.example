# Copy this file to .env.local and fill in real values.
# AUTH0_SECRET: generate with `openssl rand -hex 32`
# AUTH0_DOMAIN: found in Auth0 Dashboard → Settings (e.g. your-tenant.us.auth0.com)
# AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET: found in Auth0 Dashboard → Applications → your app
# APP_BASE_URL: your app's base URL (http://localhost:3000 for local dev)

AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
